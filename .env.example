# =============================================================================
#  Warehouse AMR — ROS 2 x Isaac Sim learning project
#  Copy this file to ".env" and adjust. NOTHING here touches your global
#  environment: every value is read from this file by warehouse_amr/config.py
#  and applied only inside the Python process that is running.
# =============================================================================

# ---- Paths -------------------------------------------------------------------
# Root of your Isaac Sim installation (the folder containing isaac-sim.bat).
ISAACSIM_ROOT=C:\isaacsim

# Root of the downloaded NVIDIA USD content packs (Industrial_NVD@..., etc).
USD_ASSETS_ROOT=D:\code\omniverse_learn\usd_assets

# Where generated artifacts go. Relative paths are resolved against this project.
OUTPUT_DIR=./_output


# ---- ROS 2 -------------------------------------------------------------------
# Isaac Sim ships its own minimal ROS 2 libraries, so you do NOT need a system
# ROS 2 install. Choose which bundled distro to use: humble | jazzy
ROS_DISTRO=humble

# DDS domain. Isaac Sim and the client scripts both read THIS value (not the
# global ROS_DOMAIN_ID), so a stray shell variable can never desync them.
ROS_DOMAIN_ID=0

# Cyclone DDS is not supported on Windows — keep FastDDS.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Prefix applied to every topic the robot publishes/subscribes ("" = no prefix).
ROS_NAMESPACE=

# Seconds without a /cmd_vel message before the robot is stopped (measured in
# simulation time). Senders must keep publishing, even an unchanged command:
# teleop and patrol send 20 per second. Rule of thumb: at least 3-5x the
# sender period, and small enough that max speed x timeout is a distance you
# can accept the robot travelling blind. 0.5 matches ros2_control's default.
CMD_VEL_TIMEOUT=0.5


# ---- Simulation --------------------------------------------------------------
# true = no GUI window (faster, needed for CI / dataset generation)
HEADLESS=false

PHYSICS_HZ=60
RENDER_HZ=30

# Publish sensor data every Nth rendered frame (1 = every frame).
CAMERA_PUBLISH_EVERY_N_FRAMES=2


# ---- Robot -------------------------------------------------------------------
ROBOT_NAME=amr
WHEEL_RADIUS=0.10
WHEEL_BASE=0.44
MAX_LINEAR_SPEED=1.0
MAX_ANGULAR_SPEED=1.5
ROBOT_START_X=-7.0
ROBOT_START_Y=0.0


# ---- Sensors -----------------------------------------------------------------
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# RTX Lidar profile. Real-world options shipped with Isaac Sim include:
#   SICK_TIM781, SICK_picoScan150, RPLIDAR_S2E, Example_Rotary_2D  (case sensitive)
# (2D profiles are the ones that produce a sensor_msgs/LaserScan)
# NOTE: these are USD assets on NVIDIA's asset server, downloaded on first
# use. Offline? Use Example_Rotary_2D, which is the smallest of them.
LIDAR_CONFIG=SICK_TIM781


# ---- Scene -------------------------------------------------------------------
# The full 128 MB photoreal warehouse building. false = fast procedural room
# (walls + floor) which loads in seconds and is plenty for learning.
LOAD_FULL_WAREHOUSE=false

NUM_PALLETS=6
NUM_RACKS=4
RANDOM_SEED=42


# ---- Synthetic Data Generation (Replicator) ----------------------------------
SDG_NUM_FRAMES=40
SDG_OUTPUT_SUBDIR=sdg_dataset
SDG_RESOLUTION_WIDTH=1024
SDG_RESOLUTION_HEIGHT=768
# Extra render subframes per capture; raise if textures look unloaded/ghosted.
SDG_SUBFRAMES=4
